{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camo.local/schemas/ux-specification.schema.json",
  "title": "Camo Canonical UX Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uxSpecificationId", "schemaVersion", "productContractId", "source", "navigation",
    "screens", "actions", "design", "localization", "acceptanceScenarios", "fixtures",
    "migrationLimitations"
  ],
  "properties": {
    "uxSpecificationId": { "type": "string", "pattern": "^ux-[0-9a-f]{16}$" },
    "schemaVersion": { "const": 1 },
    "productContractId": { "type": "string", "pattern": "^product-[0-9a-f]{16}$" },
    "source": { "enum": ["explicit-product-delivery", "legacy-migration"] },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "nodes", "edges", "deepLinks", "reachable"],
      "properties": {
        "roots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/navigationNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/navigationEdge" } },
        "deepLinks": { "type": "array", "items": { "$ref": "#/$defs/deepLink" } },
        "reachable": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "screens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/screen" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "referenceProfile", "tokens", "semanticComponentRoles", "swiftUIConsumption"],
      "properties": {
        "strategy": { "enum": ["mimicry", "differentiation"] },
        "referenceProfile": { "type": ["string", "null"] },
        "tokens": { "type": "object", "minProperties": 1 },
        "semanticComponentRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "swiftUIConsumption": {
          "type": "object", "additionalProperties": false, "required": ["environment", "rule"],
          "properties": { "environment": { "type": "string", "minLength": 3 }, "rule": { "type": "string", "minLength": 12 } }
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "catalog"],
      "properties": {
        "defaultLocale": { "const": "ru" },
        "catalog": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedString" } }
      }
    },
    "acceptanceScenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "fixtures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fixture" } },
    "migrationLimitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "navigationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "presentation", "parent", "root", "entries", "exits", "guards", "back", "dismiss"],
      "properties": {
        "id": { "type": "string" },
        "presentation": { "enum": ["root", "tab", "push", "sheet", "cover", "system", "external", "state"] },
        "parent": { "type": ["string", "null"] },
        "root": { "type": "boolean" },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/navigationEntry" } },
        "exits": { "type": "array", "items": { "$ref": "#/$defs/navigationExit" } },
        "guards": { "type": "array", "items": { "type": "string" } },
        "back": { "$ref": "#/$defs/backSemantics" },
        "dismiss": { "oneOf": [{ "$ref": "#/$defs/dismissSemantics" }, { "type": "null" }] }
      }
    },
    "navigationEntry": {
      "type": "object", "additionalProperties": false, "required": ["type", "source", "guard"],
      "properties": { "type": { "type": "string", "minLength": 2 }, "source": { "type": "string", "minLength": 2 }, "guard": { "type": ["string", "null"] } }
    },
    "navigationExit": {
      "type": "object", "additionalProperties": false, "required": ["type", "action", "destination"],
      "properties": { "type": { "type": "string", "minLength": 2 }, "action": { "type": ["string", "null"] }, "destination": { "type": ["string", "null"] } }
    },
    "navigationEdge": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "from", "to", "guard"],
      "properties": {
        "id": { "type": "string", "minLength": 3 }, "type": { "type": "string", "minLength": 2 },
        "from": { "type": ["string", "null"] }, "to": { "type": "string", "minLength": 2 }, "guard": { "type": ["string", "null"] }
      }
    },
    "deepLink": {
      "type": "object", "additionalProperties": false, "required": ["id", "pattern", "target", "guard"],
      "properties": { "id": { "type": "string", "minLength": 2 }, "pattern": { "type": "string", "minLength": 3 }, "target": { "type": "string", "minLength": 2 }, "guard": { "type": "string", "minLength": 2 } }
    },
    "backSemantics": {
      "type": "object", "additionalProperties": false, "required": ["type", "destination"],
      "properties": { "type": { "enum": ["none", "pop", "dismiss", "system-return"] }, "destination": { "type": ["string", "null"] } }
    },
    "dismissSemantics": {
      "type": "object", "additionalProperties": false, "required": ["type", "destination"],
      "properties": { "type": { "type": "string", "minLength": 3 }, "destination": { "type": "string", "minLength": 2 } }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titleKey", "purposeKey", "componentRoles", "states", "variants"],
      "properties": {
        "id": { "type": "string" },
        "titleKey": { "type": "string" },
        "purposeKey": { "type": "string" },
        "componentRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "states": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/state" } },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "canonicalState", "fixtureId"] } }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "applicable", "rationale"],
      "properties": {
        "id": { "enum": ["loading", "populated/default", "empty", "error", "offline", "permission-needed", "permission-denied", "permission-restricted", "permission-limited"] },
        "applicable": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 8 },
        "content": { "$ref": "#/$defs/stateContent" },
        "availableActions": { "type": "array", "items": { "type": "string" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/stateTransition" } },
        "recovery": { "$ref": "#/$defs/stateRecovery" }
      },
      "allOf": [{
        "if": { "properties": { "applicable": { "const": true } }, "required": ["applicable"] },
        "then": { "required": ["content", "availableActions", "transitions", "recovery"] }
      }]
    },
    "stateContent": {
      "type": "object", "additionalProperties": false, "required": ["titleKey", "bodyKey", "fixtureIds"],
      "properties": { "titleKey": { "type": "string" }, "bodyKey": { "type": "string" }, "fixtureIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "stateTransition": {
      "type": "object", "additionalProperties": false, "required": ["action", "outcome"],
      "properties": { "action": { "type": "string", "minLength": 1 }, "outcome": { "$ref": "#/$defs/outcome" } }
    },
    "stateRecovery": {
      "type": "object", "additionalProperties": false, "required": ["guidanceKey", "actionIds"],
      "properties": { "guidanceKey": { "type": "string" }, "actionIds": { "type": "array", "items": { "type": "string" } } }
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["navigate", "mutate", "request", "dismiss", "external", "system"] },
        "target": { "type": "string" }, "state": { "type": "string" }, "capability": { "type": "string" }, "destination": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "id", "labelKey", "outcome", "execution", "persistence", "enabledWhen"],
      "properties": { "surface": { "type": "string" }, "id": { "type": "string" }, "labelKey": { "type": "string" }, "outcome": { "$ref": "#/$defs/outcome" }, "execution": { "type": "string" }, "persistence": { "type": "string" }, "enabledWhen": { "type": "string" } }
    },
    "localizedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "locale", "placeholders", "pluralization", "context", "screens", "usage"],
      "properties": { "key": { "type": "string" }, "source": { "type": "string", "minLength": 1 }, "locale": { "const": "ru" }, "placeholders": { "type": "array" }, "pluralization": { "type": ["object", "null"] }, "context": { "type": "string" }, "screens": { "type": "array" }, "usage": { "type": "string" } }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "flowId", "coverage", "nameKey", "given", "when", "then"],
      "properties": {
        "id": { "type": "string" }, "flowId": { "type": "string" },
        "coverage": { "enum": ["happy-path", "failure-recovery", "offline", "persistence-return", "permission-denial-fallback"] },
        "nameKey": { "type": "string" }, "given": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioStep" } }, "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioStep" } }, "then": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioStep" } }
      }
    },
    "scenarioStep": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": { "type": { "type": "string", "minLength": 2 }, "id": { "type": "string", "minLength": 1 } }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "deterministicIds", "data", "edgeCases", "provenance", "media"],
      "properties": {
        "id": { "type": "string" }, "surface": { "type": "string" }, "state": { "type": "string" },
        "deterministicIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "data": { "type": "object", "minProperties": 3 }, "edgeCases": { "type": "array", "minItems": 2 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media" } }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["kind", "source", "note"],
      "properties": { "kind": { "type": "string", "minLength": 3 }, "source": { "type": "string", "minLength": 3 }, "note": { "type": "string", "minLength": 8 } }
    },
    "media": {
      "type": "object", "additionalProperties": false, "required": ["role", "assetId", "provenance", "license"],
      "properties": { "role": { "type": "string", "minLength": 3 }, "assetId": { "type": "string", "minLength": 3 }, "provenance": { "type": "string", "minLength": 3 }, "license": { "type": "string", "minLength": 8 } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camo.local/schemas/product-development.schema.json",
  "title": "Camo Product Development Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brief", "candidates", "selectionReceipt", "productContract"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "brief": { "$ref": "product-brief.schema.json" },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "concept-candidate.schema.json" }
    },
    "selectionReceipt": { "$ref": "selection-receipt.schema.json" },
    "productContract": { "$ref": "product-contract.schema.json" }
  }
}

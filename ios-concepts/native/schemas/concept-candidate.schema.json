{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camo.local/schemas/concept-candidate.schema.json",
  "title": "Camo Concept Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "name", "productThesis", "insight", "job", "wedge",
    "observableDifferentiation", "valueExchange", "contentModel", "contentSupply",
    "socialGraphLeverage", "coldStart", "activation", "coreLoop", "habitLoop",
    "retention", "permissions", "trustSafety", "privacy", "businessLogic", "nonGoals",
    "risks", "assumptions", "evidence", "referenceFit", "stressTest", "delivery"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 2 },
    "productThesis": { "type": "string", "minLength": 16 },
    "insight": {
      "type": "object", "additionalProperties": false, "required": ["claim", "evidenceRefs"],
      "properties": { "claim": { "type": "string", "minLength": 16 }, "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" } }
    },
    "job": {
      "type": "object", "additionalProperties": false, "required": ["actor", "situation", "motivation", "outcome"],
      "properties": {
        "actor": { "type": "string", "minLength": 8 }, "situation": { "type": "string", "minLength": 8 },
        "motivation": { "type": "string", "minLength": 8 }, "outcome": { "type": "string", "minLength": 8 }
      }
    },
    "wedge": {
      "type": "object", "additionalProperties": false, "required": ["audience", "situation", "mechanism"],
      "properties": {
        "audience": { "type": "string", "minLength": 8 }, "situation": { "type": "string", "minLength": 8 },
        "mechanism": { "type": "string", "minLength": 8 }
      }
    },
    "observableDifferentiation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "behavior", "comparator", "measurement", "threshold", "experiment", "coreLoopStep", "evidenceRefs"],
      "properties": {
        "kind": { "enum": ["behavior", "outcome", "supply"] },
        "behavior": { "type": "string", "minLength": 8 }, "comparator": { "type": "string", "minLength": 8 },
        "measurement": { "type": "string", "minLength": 8 }, "threshold": { "type": "string", "minLength": 8 },
        "experiment": { "type": "string", "minLength": 8 }, "coreLoopStep": { "type": "string", "minLength": 8 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "valueExchange": {
      "type": "object", "additionalProperties": false, "required": ["userGives", "userGets"],
      "properties": { "userGives": { "$ref": "#/$defs/nonEmptyStrings" }, "userGets": { "$ref": "#/$defs/nonEmptyStrings" } }
    },
    "contentModel": {
      "type": "object", "additionalProperties": false, "required": ["primaryUnit", "relationships"],
      "properties": { "primaryUnit": { "type": "string", "minLength": 3 }, "relationships": { "$ref": "#/$defs/nonEmptyStrings" } }
    },
    "contentSupply": {
      "type": "object", "additionalProperties": false,
      "required": ["coldStartSources", "ongoingSources", "contributorIncentives", "qualityControls"],
      "properties": {
        "coldStartSources": { "$ref": "#/$defs/nonEmptyStrings" }, "ongoingSources": { "$ref": "#/$defs/nonEmptyStrings" },
        "contributorIncentives": { "$ref": "#/$defs/nonEmptyStrings" }, "qualityControls": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "socialGraphLeverage": {
      "type": "object", "additionalProperties": false, "required": ["relationship", "mechanism", "valueWithoutGraph"],
      "properties": {
        "relationship": { "type": "string", "minLength": 8 }, "mechanism": { "type": "string", "minLength": 8 },
        "valueWithoutGraph": { "type": "string", "minLength": 8 }
      }
    },
    "coldStart": { "$ref": "#/$defs/threePartText" },
    "activation": { "$ref": "#/$defs/activation" },
    "coreLoop": { "$ref": "#/$defs/coreLoop" },
    "habitLoop": { "$ref": "#/$defs/habitLoop" },
    "retention": {
      "type": "object", "additionalProperties": false, "required": ["reasons", "leadingIndicators"],
      "properties": { "reasons": { "$ref": "#/$defs/nonEmptyStrings" }, "leadingIndicators": { "$ref": "#/$defs/nonEmptyStrings" } }
    },
    "permissions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/permission" } },
    "trustSafety": { "$ref": "#/$defs/trustSafety" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "businessLogic": { "$ref": "#/$defs/businessLogic" },
    "nonGoals": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 3 } },
    "risks": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/risk" } },
    "assumptions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/assumption" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "referenceFit": { "$ref": "#/$defs/referenceFit" },
    "stressTest": { "$ref": "#/$defs/stressTest" },
    "delivery": { "$ref": "#/$defs/delivery" }
  },
  "$defs": {
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "nonEmptyIdentifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "threePartText": {
      "type": "object", "additionalProperties": false, "required": ["firstSessionValue", "seededContent", "emptyStateAction"],
      "properties": { "firstSessionValue": { "type": "string", "minLength": 8 }, "seededContent": { "type": "string", "minLength": 8 }, "emptyStateAction": { "type": "string", "minLength": 8 } }
    },
    "activation": {
      "type": "object", "additionalProperties": false, "required": ["moment", "signal", "window"],
      "properties": { "moment": { "type": "string", "minLength": 8 }, "signal": { "type": "string", "minLength": 8 }, "window": { "type": "string", "minLength": 3 } }
    },
    "coreLoop": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "action", "reward", "contribution", "hypothesis", "successMetric", "testPlan", "evidenceRefs"],
      "properties": {
        "trigger": { "type": "string", "minLength": 8 }, "action": { "type": "string", "minLength": 8 },
        "reward": { "type": "string", "minLength": 8 }, "contribution": { "type": "string", "minLength": 8 },
        "hypothesis": { "type": "string", "minLength": 8 }, "successMetric": { "type": "string", "minLength": 8 },
        "testPlan": { "type": "string", "minLength": 8 }, "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "habitLoop": {
      "type": "object", "additionalProperties": false, "required": ["cue", "routine", "reward", "frequency"],
      "properties": { "cue": { "type": "string", "minLength": 8 }, "routine": { "type": "string", "minLength": 8 }, "reward": { "type": "string", "minLength": 8 }, "frequency": { "type": "string", "minLength": 3 } }
    },
    "permission": {
      "type": "object", "additionalProperties": false, "required": ["key", "productValue", "flow", "requestMoment", "deniedFallback", "role"],
      "properties": {
        "key": { "type": "string", "minLength": 2 }, "productValue": { "type": "string", "minLength": 8 },
        "flow": { "type": "string", "minLength": 8 }, "requestMoment": { "type": "string", "minLength": 8 },
        "deniedFallback": { "type": "string", "minLength": 8 }, "role": { "enum": ["core", "supporting"] }
      }
    },
    "trustSafety": {
      "type": "object", "additionalProperties": false, "required": ["risks", "controls", "reporting"],
      "properties": { "risks": { "$ref": "#/$defs/nonEmptyStrings" }, "controls": { "$ref": "#/$defs/nonEmptyStrings" }, "reporting": { "type": "string", "minLength": 8 } }
    },
    "privacy": {
      "type": "object", "additionalProperties": false, "required": ["data", "principles", "retention"],
      "properties": { "data": { "$ref": "#/$defs/nonEmptyStrings" }, "principles": { "$ref": "#/$defs/nonEmptyStrings" }, "retention": { "type": "string", "minLength": 8 } }
    },
    "businessLogic": {
      "type": "object", "additionalProperties": false, "required": ["model", "payer", "value", "viabilitySignal", "constraints"],
      "properties": {
        "model": { "type": "string", "minLength": 8 }, "payer": { "type": "string", "minLength": 8 },
        "value": { "type": "string", "minLength": 8 }, "viabilitySignal": { "type": "string", "minLength": 8 },
        "constraints": { "type": "string", "minLength": 8 }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["risk", "mitigation", "killSignal"],
      "properties": { "risk": { "type": "string", "minLength": 8 }, "mitigation": { "type": "string", "minLength": 8 }, "killSignal": { "type": "string", "minLength": 8 } }
    },
    "assumption": {
      "type": "object", "additionalProperties": false, "required": ["claim", "risk", "validation", "status"],
      "properties": { "claim": { "type": "string", "minLength": 8 }, "risk": { "enum": ["low", "medium", "high"] }, "validation": { "type": "string", "minLength": 8 }, "status": { "enum": ["needs-validation", "validated", "rejected"] } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "source", "status", "supports"],
      "properties": {
        "id": { "type": "string", "minLength": 2 }, "type": { "enum": ["user-input", "research", "reference-profile", "experiment", "assumption"] },
        "source": { "type": "string", "minLength": 8 }, "status": { "enum": ["observed", "validated", "approved", "needs-validation"] },
        "supports": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "referenceFit": {
      "type": "object", "additionalProperties": false, "required": ["profileId", "mentalModel", "naturalFit", "borrowedPatterns", "productMapping", "tensions", "evidenceRefs"],
      "properties": {
        "profileId": { "type": ["string", "null"], "minLength": 2 }, "mentalModel": { "type": "string", "minLength": 8 },
        "naturalFit": { "type": "string", "minLength": 8 }, "borrowedPatterns": { "$ref": "#/$defs/nonEmptyIdentifiers" },
        "productMapping": { "type": "string", "minLength": 8 }, "tensions": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "stressTest": {
      "type": "object", "additionalProperties": false, "required": ["axes"],
      "properties": {
        "axes": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/stressAxis" } }
      }
    },
    "stressAxis": {
      "type": "object", "additionalProperties": false, "required": ["id", "score", "rationale", "evidenceRefs", "failureModes"],
      "properties": {
        "id": { "type": "string" }, "score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "rationale": { "type": "string", "minLength": 16 }, "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "failureModes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainGlossary", "personas", "criticalFlows", "architecture", "data",
        "experienceStates", "accessibility", "localization", "analytics", "testing",
        "setup", "ownership", "limitations", "acceptanceCriteria", "appStoreNotes"
      ],
      "properties": {
        "domainGlossary": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["term", "definition"],
            "properties": { "term": { "type": "string", "minLength": 2 }, "definition": { "type": "string", "minLength": 8 } }
          }
        },
        "personas": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "context", "job"],
            "properties": { "name": { "type": "string", "minLength": 2 }, "context": { "type": "string", "minLength": 8 }, "job": { "type": "string", "minLength": 8 } }
          }
        },
        "criticalFlows": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "trigger", "steps", "outcome"],
            "properties": {
              "id": { "type": "string", "minLength": 2 }, "name": { "type": "string", "minLength": 3 },
              "trigger": { "type": "string", "minLength": 2 }, "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
              "outcome": { "type": "string", "minLength": 8 }
            }
          }
        },
        "architecture": {
          "type": "object", "additionalProperties": false, "required": ["modules", "boundaries"],
          "properties": {
            "modules": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["name", "responsibility", "owns"],
                "properties": { "name": { "type": "string", "minLength": 3 }, "responsibility": { "type": "string", "minLength": 8 }, "owns": { "type": "string", "minLength": 3 } }
              }
            },
            "boundaries": { "$ref": "#/$defs/nonEmptyStrings" }
          }
        },
        "data": {
          "type": "object", "additionalProperties": false, "required": ["entities", "state", "persistence", "integrations"],
          "properties": {
            "entities": { "$ref": "#/$defs/nonEmptyIdentifiers" }, "state": { "$ref": "#/$defs/nonEmptyStrings" },
            "persistence": { "$ref": "#/$defs/nonEmptyStrings" }, "integrations": { "$ref": "#/$defs/nonEmptyStrings" }
          }
        },
        "experienceStates": {
          "type": "object", "additionalProperties": false, "required": ["loading", "empty", "error", "denied", "offline"],
          "properties": {
            "loading": { "type": "string", "minLength": 8 }, "empty": { "type": "string", "minLength": 8 },
            "error": { "type": "string", "minLength": 8 }, "denied": { "type": "string", "minLength": 8 },
            "offline": { "type": "string", "minLength": 8 }
          }
        },
        "accessibility": { "$ref": "#/$defs/nonEmptyStrings" },
        "localization": {
          "type": "object", "additionalProperties": false, "required": ["locales", "requirements"],
          "properties": { "locales": { "$ref": "#/$defs/nonEmptyIdentifiers" }, "requirements": { "$ref": "#/$defs/nonEmptyStrings" } }
        },
        "analytics": {
          "type": "object", "additionalProperties": false, "required": ["events", "successMetrics"],
          "properties": { "events": { "$ref": "#/$defs/nonEmptyStrings" }, "successMetrics": { "$ref": "#/$defs/nonEmptyStrings" } }
        },
        "testing": {
          "type": "object", "additionalProperties": false, "required": ["levels", "evidencePlan", "capturePlan"],
          "properties": { "levels": { "$ref": "#/$defs/nonEmptyStrings" }, "evidencePlan": { "$ref": "#/$defs/nonEmptyStrings" }, "capturePlan": { "$ref": "#/$defs/nonEmptyStrings" } }
        },
        "setup": {
          "type": "object", "additionalProperties": false, "required": ["prerequisites", "build", "run"],
          "properties": { "prerequisites": { "$ref": "#/$defs/nonEmptyStrings" }, "build": { "$ref": "#/$defs/nonEmptyStrings" }, "run": { "$ref": "#/$defs/nonEmptyStrings" } }
        },
        "ownership": {
          "type": "object", "additionalProperties": false, "required": ["generated", "owned"],
          "properties": { "generated": { "$ref": "#/$defs/nonEmptyStrings" }, "owned": { "$ref": "#/$defs/nonEmptyStrings" } }
        },
        "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
        "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "appStoreNotes": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}

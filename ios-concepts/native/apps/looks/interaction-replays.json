{
  "schemaVersion": 2,
  "scenarios": [
    { "id": "phone-disabled-enabled-navigation", "covers": ["phone.continue-email"], "steps": [
      { "do": "input", "value": { "email": "wrong" } }, { "do": "invoke", "action": "phone.continue-email" },
      { "do": "assert", "path": "phase.phone.continue-email", "equals": "disabled" },
      { "do": "input", "value": { "email": "nika@example.com" } }, { "do": "invoke", "action": "phone.continue-email" },
      { "do": "assert", "path": "route", "equals": "code" }
    ] },
    { "id": "code-complete-navigation", "covers": ["code.confirm-code"], "steps": [
      { "do": "input", "value": { "code": "1234" } }, { "do": "invoke", "action": "code.confirm-code" },
      { "do": "assert", "path": "route", "equals": "home" }
    ] },
    { "id": "codefail-retry-navigation", "covers": ["codefail.retry-code"], "steps": [
      { "do": "input", "value": { "code": "1234" } }, { "do": "invoke", "action": "codefail.retry-code" },
      { "do": "assert", "path": "route", "equals": "code" }
    ] },
    { "id": "location-failure-fallback-retry-success", "covers": ["nearby.enable-location"], "adapterAnswers": [false, true], "steps": [
      { "do": "invoke", "action": "nearby.enable-location" },
      { "do": "assert", "path": "phase.nearby.enable-location", "equals": "error" },
      { "do": "fallback", "action": "nearby.enable-location" },
      { "do": "assert", "path": "handoff", "equals": { "type": "manual", "action": "choose-district" } },
      { "do": "invoke", "action": "nearby.enable-location" },
      { "do": "assert", "path": "handoff", "equals": { "type": "system", "capability": "location" } }
    ] },
    { "id": "create-camera-navigation", "covers": ["create.open-camera"], "steps": [
      { "do": "invoke", "action": "create.open-camera" }, { "do": "assert", "path": "route", "equals": "camera" }
    ] },
    { "id": "camera-failure-alternate-retry-success", "covers": ["camera.capture-photo"], "adapterAnswers": [false, true], "steps": [
      { "do": "invoke", "action": "camera.capture-photo" }, { "do": "fallback", "action": "camera.capture-photo" },
      { "do": "assert", "path": "handoff", "equals": { "type": "alternate", "action": "choose-photo" } },
      { "do": "invoke", "action": "camera.capture-photo" },
      { "do": "assert", "path": "handoff", "equals": { "type": "system", "capability": "camera" } }
    ] },
    { "id": "event-persist-restore", "covers": ["event.join-event"], "steps": [
      { "do": "invoke", "action": "event.join-event" }, { "do": "assert", "path": "product.joinedEvents", "equals": true },
      { "do": "restore" }, { "do": "assert", "path": "product.joinedEvents", "equals": true }
    ] },
    { "id": "faceid-failure-passcode-retry-success", "covers": ["lock.request-face-id"], "adapterAnswers": [false, true], "steps": [
      { "do": "invoke", "action": "lock.request-face-id" }, { "do": "fallback", "action": "lock.request-face-id" },
      { "do": "assert", "path": "handoff", "equals": { "type": "manual", "action": "device-passcode" } },
      { "do": "invoke", "action": "lock.request-face-id" },
      { "do": "assert", "path": "handoff", "equals": { "type": "system", "capability": "faceid" } }
    ] },
    { "id": "subtitles-persist-restore", "covers": ["subtitles.publish-captioned-clip"], "steps": [
      { "do": "invoke", "action": "subtitles.publish-captioned-clip" },
      { "do": "assert", "path": "product.localPublishedClips", "equals": true },
      { "do": "restore" }, { "do": "assert", "path": "product.localPublishedClips", "equals": true }
    ] },
    { "id": "background-navigation", "covers": ["background.return-to-talk"], "steps": [
      { "do": "invoke", "action": "background.return-to-talk" }, { "do": "assert", "path": "route", "equals": "talk" }
    ] },
    { "id": "venue-network-failure-fallback-retry-persist-restore", "covers": ["netqr.join-venue-network"], "adapterAnswers": [false, true], "steps": [
      { "do": "invoke", "action": "netqr.join-venue-network" }, { "do": "fallback", "action": "netqr.join-venue-network" },
      { "do": "assert", "path": "handoff", "equals": { "type": "manual", "action": "organizer-confirmation" } },
      { "do": "invoke", "action": "netqr.join-venue-network" },
      { "do": "assert", "path": "product.venueNetworkJoined", "equals": true },
      { "do": "restore" }, { "do": "assert", "path": "product.venueNetworkJoined", "equals": true }
    ] },
    { "id": "shared-draft-persist-restore", "covers": ["shareext.save-shared-draft"], "steps": [
      { "do": "invoke", "action": "shareext.save-shared-draft" }, { "do": "assert", "path": "product.sharedDraft", "equals": true },
      { "do": "restore" }, { "do": "assert", "path": "product.sharedDraft", "equals": true }
    ] },
    { "id": "checkin-failure-retry-success-restore", "covers": ["checkin.confirm-swap-checkin"], "adapterAnswers": [false, true], "steps": [
      { "do": "product", "value": { "venueNetworkJoined": true } },
      { "do": "invoke", "action": "checkin.confirm-swap-checkin" }, { "do": "fallback", "action": "checkin.confirm-swap-checkin" },
      { "do": "assert", "path": "handoff", "equals": { "type": "manual", "action": "organizer-confirmation" } },
      { "do": "invoke", "action": "checkin.confirm-swap-checkin" }, { "do": "assert", "path": "product.checkedIn", "equals": true },
      { "do": "restore" }, { "do": "assert", "path": "product.checkedIn", "equals": true }
    ] }
  ]
}

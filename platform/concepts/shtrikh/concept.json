  "backendless": [
    {
      "needs": "Аккаунт и социальный граф",
      "solution": "Firebase Authentication и Firestore SDK; токен в общей Keychain group"
    },
    {
      "needs": "Лента, реакции и серии",
      "solution": "Firestore с клиентскими security rules и Cloud Storage SDK"
    },
    {
      "needs": "Карта мест",
      "solution": "MapKit и локальный каталог сохранённых точек"
    },
    {
      "needs": "Пленэры и календарь",
      "solution": "EventKit; идентификатор созданного события хранится локально"
    },
    {
      "needs": "Сопоставление контактов",
      "solution": "CNContactStore; номера хешируются на устройстве"
    },
    {
      "needs": "Фоновое обновление и уведомления",
      "solution": "FCM, background fetch и BGTaskScheduler"
    },
    {
      "needs": "Выставочный экран",
      "solution": "Локальная Wi‑Fi-сеть площадки; подключение через NEHotspotConfigurationManager"
    },
    {
      "needs": "Реклама материалов",

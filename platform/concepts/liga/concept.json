{
  "slug": "liga",
  "name": "Лига",
  "eyebrow": "Лига · Живой любительский спорт · iOS",
  "targetSet": "vk-video",
  "domain": "liga.video",
  "heroTitle": "Лига — матч становится видео",
  "heroDeck": "Прямые эфиры, полные записи и короткие моменты любительских матчей в одном видеосервисе.",
  "tagline": "Смотрите, снимайте и сохраняйте лучшие моменты игры",
  "insight": "любительские команды умеют играть, но почти никогда не могут позволить себе оператора, режиссёра и монтаж хайлайтов",
  "deck": "Видеосервис любительского спорта. Зритель смотрит прямые эфиры, записи и вертикальные моменты; автор запускает трансляцию или загружает видео; протокол синхронизируется с записью и помогает быстро находить ключевые эпизоды.",
  "qualityContractVersion": 1,
  "product": {
    "audience": "Любительские спортивные лиги, команды, игроки и их болельщики",
    "situation": "Матч играют без профессиональной съёмочной команды, но участникам нужны эфир, счёт и моменты",
    "problem": "Один телефон даёт лишь длинную запись, а счёт, составы и хайлайты приходится собирать отдельно",
    "promise": "Снять матч одним телефоном, получить живой протокол и готовые моменты без монтажа",
    "differentiator": "Синхронизирует съёмку и события любительского матча, а не пытается быть общим видеохостингом",
    "returnReasons": [
      "Ближайшие матчи своей команды",
      "Новые моменты после игры",
      "Эфиры и обновления подписанных команд"
    ],
    "verticalSlice": {
      "entry": "phone",
      "action": "camera",
      "result": "moments"
    },
    "coreLoop": [
      "Открыть матч и составы",
      "Снять эфир и отмечать события",
      "Получить протокол и клипы"
    ],
    "nonGoals": [
      "Профессиональная телетрансляция",
      "Беттинг",
      "Общий видеоредактор"
    ]
  },
  "positioning": {
    "mode": "mimicry",
    "categoryFit": "Видео, эфиры и клипы обосновывают основную категорию Photo & Video, а спортивная специализация — вторичную Sports",

{
  "slug": "rehearsal",
  "name": "Репетиция",
  "eyebrow": "Репетиция · Тренер выступлений на видео · iOS",
  "targetSet": "vk-video",
  "domain": "rehearsal.app",
  "heroTitle": "Репетиция — прогон на видео до выступления",
  "heroDeck": "Запишите прогон на камеру, увидьте, какой блок затянулся, и повторите только его. Уроки от школ выступлений — в той же ленте.",
  "tagline": "Видеопрогон, разбор по блокам и уроки выступлений",
  "insight": "повторять выступление целиком утомительно, а перетянутый момент трудно заметить без временной шкалы",
  "deck": "Видеоприложение в грамматике ВК Видео: лента уроков и своих прогонов, запись с камерой и звуком, разбор по таймкодам, AirPlay и фоновое прослушивание.",
  "qualityContractVersion": 1,
  "product": {
    "audience": "Люди, которые готовят доклад, питч или видеовыступление без личного тренера",
    "situation": "После прогона видно, что выступление не укладывается во время, но непонятно, где оно просело",
    "problem": "Повторять весь доклад утомительно, а по обычной записи трудно найти слабый момент",
    "promise": "Временная шкала покажет слабый фрагмент, и повторить можно только его",
    "differentiator": "Не видеоредактор и не лента роликов, а цикл «прогон на видео → находка → точечный повтор», а уроки подсказывают, что тренировать",
    "returnReasons": [
      "Новый прогон перед выступлением",
      "Повтор отмеченного слабого момента",
      "Новый выпуск урока в подписках"
    ],
    "verticalSlice": {
      "entry": "phone",
      "action": "recording",
      "result": "analysis"
    },
    "coreLoop": [
      "Задать план и целевое время",
      "Записать один прогон",
      "Найти и повторить слабый момент"
    ],
    "nonGoals": [
      "Автоматическое написание речи",
      "Публикация прогонов в ленту",
      "Облачная командная работа"
    ]
  },
  "positioning": {
    "mode": "mimicry",
    "categoryFit": "Запись видео со звуком, разбор, просмотр уроков, AirPlay и экспорт в «Фото» — ядро Photo & Video, как у ВК Видео",
    "familiarPatterns": [
      "Лента видеокарточек 16:9 с длительностью и прогрессом просмотра",
      "Подписки на авторов уроков с отметкой новых выпусков",
      "Плеер с автором, «Дальше», AirPlay и фоновым звуком"
    ],
    "distinctions": [
      "Главный контент — собственные прогоны, а не чужие ролики",
      "Таймлайн размечен блоками выступления и метками, а не главами ролика",
      "Главное действие — повторить слабый блок, а не досмотреть"
